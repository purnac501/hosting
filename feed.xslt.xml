<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:atom="http://www.w3.org/2005/Atom">
  <xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>
  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>RSS Feed &#183; <xsl:value-of select="//*[local-name()='title'][1]"/></title>
        <style>
          :root {
            --bg: #ffffff;
            --text: #27272a;
            --muted: #71717a;
            --border: #e4e4e7;
            --accent: #2563eb;
            --card: #f8fafc;
          }
          @media (prefers-color-scheme: dark) {
            :root {
              --bg: #121214;
              --text: #d4d4d8;
              --muted: #a1a1aa;
              --border: #2e2e33;
              --accent: #60a5fa;
              --card: #18181b;
            }
          }
          * { box-sizing: border-box; margin: 0; padding: 0; }
          body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            padding: 40px 20px;
          }
          .container {
            max-width: 680px;
            margin: 0 auto;
          }
          .header {
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
          }
          h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 6px;
          }
          .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 16px;
            color: var(--muted);
            text-decoration: none;
            font-size: 13px;
          }
          .back-link:hover { color: var(--accent); }
          .info-box {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 24px;
            font-size: 14px;
          }
          .info-box p { margin-bottom: 8px; }
          .info-box p:last-child { margin-bottom: 0; }
          code {
            background: var(--bg);
            border: 1px solid var(--border);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 13px;
            font-family: monospace;
            word-break: break-all;
          }
          h2 {
            font-size: 18px;
            margin: 24px 0 12px;
            color: var(--text);
          }
          .post-list {
            list-style: none;
          }
          .post-item {
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 12px;
          }
          .post-title {
            font-weight: 600;
            color: var(--accent);
            text-decoration: none;
            font-size: 15px;
          }
          .post-title:hover { text-decoration: underline; }
          .post-date {
            font-size: 12px;
            color: var(--muted);
            flex-shrink: 0;
          }
        </style>
      </head>
      <body>
        <div class="container">
          <a href="/hosting/" class="back-link">
            <svg class="lucide lucide-arrow-left" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <span>Back to blog</span>
          </a>
          <div class="header">
            <h1>RSS Feed &#183; <xsl:value-of select="//*[local-name()='title'][1]"/></h1>
          </div>
          
          <div class="info-box">
            <p><strong>This is an RSS / Atom feed.</strong> Subscribe by copying this URL into your favorite RSS reader (such as NetNewsWire, Feedly, FreshRSS, Thunderbird, etc.):</p>
            <p><code><xsl:value-of select="//*[local-name()='link'][@rel='self']/@href"/></code></p>
          </div>

          <h2>Recent Posts in Feed</h2>
          <ul class="post-list">
            <xsl:for-each select="//*[local-name()='entry']">
              <li class="post-item">
                <a>
                  <xsl:attribute name="href"><xsl:value-of select="*[local-name()='link']/@href"/></xsl:attribute>
                  <xsl:attribute name="class">post-title</xsl:attribute>
                  <xsl:value-of select="*[local-name()='title']"/>
                </a>
                <span class="post-date">
                  <xsl:value-of select="substring(*[local-name()='published'], 1, 10)"/>
                </span>
              </li>
            </xsl:for-each>
          </ul>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
