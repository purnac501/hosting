source "https://rubygems.org"

# Version pins match what GitHub Pages currently runs
# (see https://pages.github.com/versions/), so local builds
# behave like the published site.
gem "jekyll", "~> 3.10.0"
gem "jekyll-feed", "~> 0.17.0"
gem "kramdown-parser-gfm"

# Ruby 3.4+ removed these from the default gems; older jekyll deps need them.
# GitHub Pages ignores this Gemfile and uses its own environment.
gem "bigdecimal"
gem "base64"
